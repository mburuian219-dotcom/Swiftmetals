generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model catalogproduct {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  isPublic    Boolean  @default(true)
  inStock     Boolean  @default(true)
  image       String?
}

model customer {
  id                Int                 @id @default(autoincrement())
  name              String
  email             String?
  createdAt         DateTime            @default(now())
  phone             String?
  totalCredit       Float               @default(0)
  manualmessagetask manualmessagetask[]
  order             order[]
  sale              sale[]
  smsreminder       smsreminder[]
  deletedsale       deletedsale[]        // Added relation
}

model expense {
  id        Int      @id @default(autoincrement())
  title     String
  amount    Float
  category  String?
  notes     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cashledger cashledger[]
}

model invoice {
  id            Int      @id @default(autoincrement())
  invoiceNumber String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  saleId        Int
  totalAmount   Float
  amountPaid    Float    @default(0)
  balance       Float
  generatedBy   Int
  status        String   @default("UNPAID")
  sale          sale     @relation(fields: [saleId], references: [id])

  @@index([saleId])
}

model manualmessagetask {
  id            Int       @id @default(autoincrement())
  customerId    Int
  phone         String
  message       String
  failureReason String?
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
  customer      customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
}

model order {
  id         Int      @id @default(autoincrement())
  quantity   Int
  amount     Float
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  customerId Int
  productId  Int
  customer   customer @relation(fields: [customerId], references: [id])
  product    product  @relation(fields: [productId], references: [id])

  @@index([customerId])
  @@index([productId])
}

model payment {
  id               Int            @id @default(autoincrement())
  saleId           Int
  amount           Float
  method           String
  note             String?
  paidAt           DateTime       @default(now())
  bankName         String?
  checkDate        DateTime?
  checkNumber      String?
  isVerified       Boolean        @default(false)
  referenceId      String?
  verifiedAt       DateTime?
  checkDepositDate DateTime?
  status           payment_status @default(PENDING)
  sale             sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([isVerified])
  @@index([method])
  @@index([saleId])
  @@index([status])
}

model paymentschedule {
  id                Int       @id @default(autoincrement())
  saleId            Int
  installmentNumber Int
  dueAmount         Float
  dueDate           DateTime
  isPaid            Boolean   @default(false)
  paidAmount        Float     @default(0)
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  sale              sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([dueDate])
  @@index([isPaid])
  @@index([saleId])
}

model openingbalance {
  id          Int      @id @default(autoincrement())
  amount      Float
  date        DateTime @default(now())
  description String?
  recordedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model product {
  id               Int               @id @default(autoincrement())
  name             String
  description      String?
  price            Float
  category         String?
  productionCost   Float?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isPublic         Boolean           @default(false)
  image            String?
  inStock          Boolean           @default(true)
  order            order[]
  saleitem         saleitem[]
  stock            stock[]
  restock          restock[]
  staffInventories staffInventory[]
}

model stock {
  id           Int      @id @default(autoincrement())
  name         String
  quantity     Int      @default(0)
  costPrice    Float
  sellingPrice Float
  supplier     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  productId    Int
  product      product  @relation(fields: [productId], references: [id])

  @@index([productId])
}

model restock {
  id              Int       @id @default(autoincrement())
  productId       Int
  quantity        Int
  costPrice       Float
  totalCost       Float
  paymentSource   String
  creditorId      Int?
  creditor        creditor? @relation(fields: [creditorId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  product         product   @relation(fields: [productId], references: [id])

  cashledger      cashledger[] @relation("RestockToLedger")

  @@index([productId])
  @@index([creditorId])
}

model cashledger {
  id                   Int       @id @default(autoincrement())
  date                 DateTime  @default(now())
  description          String
  type                 String
  category             String
  amount               Float
  runningBalance       Float?
  relatedTo            String?
  affectedAccounts     String?
  referenceId          Int?
  referenceType        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  email                String?
  token                String?

  saleId     Int?
  sale       sale?       @relation(fields: [saleId], references: [id])
  expenseId  Int?
  expense    expense?    @relation(fields: [expenseId], references: [id])
  restockId  Int?
  restock    restock?    @relation("RestockToLedger", fields: [restockId], references: [id])
  dailyOpeningBalanceId Int?
  dailyOpeningBalance   dailyopeningbalance? @relation(fields: [dailyOpeningBalanceId], references: [id])

  @@index([date])
  @@index([type])
  @@index([category])
  @@index([referenceType])
}

model dailyopeningbalance {
  id          Int       @id @default(autoincrement())
  date        DateTime  @default(now())
  amount      Float
  description String?
  recordedBy  String?
  cashledgers cashledger[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model sale {
  id               Int       @id @default(autoincrement())
  customerId       Int
  amount           Float
  date             DateTime  @default(now())
  createdAt        DateTime  @default(now())
  dueDate          DateTime?
  status           String    @default("UNPAID")
  updatedAt        DateTime  @updatedAt

  checkDepositDate DateTime?
  isCheckDeposited Boolean   @default(false)

  lastReminderDate DateTime?
  paymentMethod    String    @default("CASH")
  remindersSent    Int       @default(0)

  // Soft delete fields
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  deletedBy        String?
  deletionReason   String?

  invoice          invoice[]
  payment          payment[]
  paymentschedule  paymentschedule[]
  saleitem         saleitem[]
  smsreminder      smsreminder[]
  cashledger       cashledger[]
  auditLogs        saleauditlog[]      // Added relation for audit logs

  customer         customer @relation(fields: [customerId], references: [id])

  // Audit fields
  updatedBy        String?
  createdBy        String?

  // Relation to staff
  createdById      Int?
  staff            staff? @relation("StaffSales", fields: [createdById], references: [id])

  @@index([checkDepositDate])
  @@index([customerId])
  @@index([dueDate])
  @@index([paymentMethod])
  @@index([status])
  @@index([isDeleted])      // Added index for soft delete queries
  @@index([deletedAt])
}

model saleitem {
  id               Int            @id @default(autoincrement())
  quantity         Int
  productId        Int
  saleId           Int
  price            Float
  total            Float
  staffInventoryId Int?
  product          product        @relation(fields: [productId], references: [id])
  sale             sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  staffInventory   staffInventory? @relation(fields: [staffInventoryId], references: [id])

  @@index([staffInventoryId])
  @@index([productId])
  @@index([saleId])
}

model creditor {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  phone       String?
  email       String?
  totalOwed   Float     @default(0)
  restocks    restock[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model staff {
  id               Int               @id @default(autoincrement())
  name             String
  email            String?
  phone            String?
  staffInventories staffInventory[]
  sales            sale[]            @relation("StaffSales")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model staffInventory {
  id               Int       @id @default(autoincrement())
  staffId          Int
  productId        Int

  weekStartDate    DateTime?  // TEMP
  weekEndDate      DateTime?  // TEMP

  quantityGiven    Int
  quantitySold     Int       @default(0)
  quantityReturned Int       @default(0)

  staff            staff     @relation(fields: [staffId], references: [id])
  product          product   @relation(fields: [productId], references: [id])
  saleItems        saleitem[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([staffId])
  @@index([productId])
}

model smsreminder {
  id          Int       @id @default(autoincrement())
  saleId      Int
  customerId  Int
  phone       String
  message     String
  type        String
  status      String    @default("SENT")
  sentAt      DateTime  @default(now())
  deliveredAt DateTime?
  customer    customer  @relation(fields: [customerId], references: [id])
  sale        sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([saleId])
  @@index([status])
  @@index([type])
}

model systemsetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime

  @@index([key])
}

// ==================== NEW MODELS FOR AUDIT & SOFT DELETE ====================

// 1. Audit Log for tracking all changes to sales
model saleauditlog {
  id              Int      @id @default(autoincrement())
  saleId          Int
  action          String   // "CREATE", "UPDATE", "DELETE", "RESTORE"
  fieldName       String?  // Which field was changed (for updates)
  oldValue        String?  // JSON string of old value
  newValue        String?  // JSON string of new value
  difference      String?  // Human readable description of change
  changedBy       String   // User email or ID who made the change
  changedByEmail  String?
  changedAt       DateTime @default(now())
  ipAddress       String?
  userAgent       String?
  
  // For bulk operations or additional context
  snapshot        Json?    // Full before/after snapshot
  notes           String?
  
  // Relations
  sale            sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  @@index([saleId])
  @@index([action])
  @@index([changedAt])
  @@index([changedBy])
}

// 2. Deleted Sales Archive (soft delete storage)
model deletedsale {
  id                Int      @id @default(autoincrement())
  originalSaleId    Int      @unique  // Original sale ID before deletion
  saleData          Json              // Complete sale data as JSON
  
  // Customer info at time of deletion (denormalized for search)
  customerName      String
  customerPhone     String?
  customerId        Int?
  
  // Sale details
  totalAmount       Float
  saleDate          DateTime
  statusAtDeletion  String   // "PAID", "PARTIAL", "UNPAID"
  dueDate           DateTime?
  
  // Deletion metadata
  deletedAt         DateTime @default(now())
  deletedBy         String
  deletedByEmail    String?
  deletionReason    String?
  ipAddress         String?
  
  // Restore tracking
  restoredAt        DateTime?
  restoredBy        String?
  restoredByEmail   String?
  
  // Additional data
  saleItemsSummary  String   // Human readable summary of items
  paymentsSummary   String?  // Human readable summary of payments
  restockedItems    Boolean  @default(false)  // Whether items were restocked
  
  // For automatic cleanup (7 days after deletion)
  expiresAt         DateTime
  
  // Relations - link back to original customer (optional, since customer might be deleted)
  customer          customer? @relation(fields: [customerId], references: [id])
  
  @@index([deletedAt])
  @@index([expiresAt])
  @@index([originalSaleId])
  @@index([customerName])
  @@index([deletedBy])
  @@index([statusAtDeletion])
  @@index([customerId])
  @@index([restoredAt])
}

enum payment_status {
  PENDING
  CLEARED
  BOUNCED
  COMPLETED
}