generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model catalogproduct {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  isPublic    Boolean  @default(true)
  inStock     Boolean  @default(true)
  image       String?
}

model customer {
  id                Int                 @id @default(autoincrement())
  name              String
  email             String?
  createdAt         DateTime            @default(now())
  phone             String?
  totalCredit       Float               @default(0)
  manualmessagetask manualmessagetask[]
  order             order[]
  sale              sale[]
  smsreminder       smsreminder[]
  deletedsale       deletedsale[]
  tradeins          tradein[]   
}

model expense {
  id          Int      @id @default(autoincrement())
  title       String
  amount      Float
  category    String?
  notes       String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById Int?
  updatedById Int?

  createdBy   staff?   @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  updatedBy   staff?   @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id])

  cashledger  cashledger[]

  @@index([createdById])
  @@index([updatedById])
}

model invoice {
  id            Int      @id @default(autoincrement())
  invoiceNumber String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  saleId        Int
  totalAmount   Float
  amountPaid    Float    @default(0)
  balance       Float
  generatedBy   Int
  status        String   @default("UNPAID")
  sale          sale     @relation(fields: [saleId], references: [id])

  @@index([saleId])
}

model manualmessagetask {
  id            Int       @id @default(autoincrement())
  customerId    Int
  phone         String
  message       String
  failureReason String?
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
  customer      customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
}

model order {
  id         Int      @id @default(autoincrement())
  quantity   Int
  amount     Float
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  customerId Int
  productId  Int
  customer   customer @relation(fields: [customerId], references: [id])
  product    product  @relation(fields: [productId], references: [id])

  @@index([customerId])
  @@index([productId])
}

model payment {
  id               Int            @id @default(autoincrement())
  saleId           Int?
  amount           Float
  method           String
  note             String?
  paidAt           DateTime       @default(now())

  bankName         String?
  checkDate        DateTime?
  checkNumber      String?

  isVerified       Boolean        @default(false)
  referenceId      String?
  verifiedAt       DateTime?
  checkDepositDate DateTime?

  status           payment_status @default(PENDING)

  // Sale relation (optional now)
  sale             sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  tradeins         tradein[]

  // =====================================
  // CREDITOR PAYMENT SUPPORT
  // =====================================

  creditorId       Int?
  creditor         creditor?      @relation("CreditorPayments", fields: [creditorId], references: [id])

  paymentType      String         @default("sale") // "sale" or "creditor"

  recordedBy       String?
  recordedByEmail  String?

  paymentDate      DateTime?

  @@index([isVerified])
  @@index([method])
  @@index([saleId])
  @@index([status])
  @@index([creditorId])
  @@index([paymentType])
}

model paymentschedule {
  id                Int       @id @default(autoincrement())
  saleId            Int
  installmentNumber Int
  dueAmount         Float
  dueDate           DateTime
  isPaid            Boolean   @default(false)
  paidAmount        Float     @default(0)
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  sale              sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([dueDate])
  @@index([isPaid])
  @@index([saleId])
}

model openingbalance {
  id          Int      @id @default(autoincrement())
  amount      Float
  date        DateTime @default(now())
  description String?
  recordedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model product {
  id               Int               @id @default(autoincrement())
  name             String
  description      String?
  price            Float
  category         String?
  productionCost   Float?
   costHistory      productCostHistory[] // New relation
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isPublic         Boolean           @default(false)
  image            String?
  inStock          Boolean           @default(true)
  order            order[]
  saleitem         saleitem[]
  stock            stock[]
  restock          restock[]
  staffInventories staffInventory[]
}

model stock {
  id           Int      @id @default(autoincrement())
  name         String
  quantity     Int      @default(0)
  costPrice    Float
  sellingPrice Float
  supplier     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  productId    Int
  product      product  @relation(fields: [productId], references: [id])

  @@index([productId])
}

model restock {
  id              Int       @id @default(autoincrement())
  productId       Int
  quantity        Int
  costPrice       Float
  totalCost       Float
  paymentSource   String
  creditorId      Int?
  creditor        creditor? @relation(fields: [creditorId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  product         product   @relation(fields: [productId], references: [id])

  cashledger      cashledger[] @relation("RestockToLedger")

  @@index([productId])
  @@index([creditorId])
}

model cashledger {
  id                   Int       @id @default(autoincrement())
  date                 DateTime  @default(now())
  description          String
  type                 String
  category             String
  amount               Float
  runningBalance       Float?
  relatedTo            String?
  affectedAccounts     String?
  referenceId          Int?
  referenceType        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  email                String?
  token                String?

  saleId     Int?
  sale       sale?       @relation(fields: [saleId], references: [id])
  expenseId  Int?
  expense    expense?    @relation(fields: [expenseId], references: [id])
  restockId  Int?
  restock    restock?    @relation("RestockToLedger", fields: [restockId], references: [id])
  dailyOpeningBalanceId Int?
  dailyOpeningBalance   dailyopeningbalance? @relation(fields: [dailyOpeningBalanceId], references: [id])

  @@index([date])
  @@index([type])
  @@index([category])
  @@index([referenceType])
}

model dailyopeningbalance {
  id          Int       @id @default(autoincrement())
  date        DateTime  @default(now())
  amount      Float
  description String?
  recordedBy  String?
  cashledgers cashledger[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model sale {
  id               Int       @id @default(autoincrement())
  customerId       Int
  amount           Float
  date             DateTime  @default(now())
  createdAt        DateTime  @default(now())
  dueDate          DateTime?
  status           String    @default("UNPAID")
  updatedAt        DateTime  @updatedAt

  checkDepositDate DateTime?
  isCheckDeposited Boolean   @default(false)

  lastReminderDate DateTime?
  paymentMethod    String    @default("CASH")
  remindersSent    Int       @default(0)

  // Soft delete fields
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  deletedBy        String?
  deletionReason   String?

  invoice          invoice[]
  payment          payment[]
  paymentschedule  paymentschedule[]
  saleitem         saleitem[]
  smsreminder      smsreminder[]
  cashledger       cashledger[]
  auditLogs        saleauditlog[]

  customer         customer @relation(fields: [customerId], references: [id])

  // =========================
  // AUDIT FIELDS
  // =========================

  updatedBy        String?
  createdBy        String?

  // =========================
  // SYSTEM CREATOR
  // =========================

  createdById      Int?
  createdByStaff   staff? @relation("CreatedSales", fields: [createdById], references: [id])

  // =========================
  // RESPONSIBLE SALESPERSON
  // =========================

  assignedStaffId  Int?
  assignedStaff    staff? @relation("AssignedSales", fields: [assignedStaffId], references: [id])
  tradeins         tradein[]

  @@index([assignedStaffId])
  @@index([createdById])
  @@index([checkDepositDate])
  @@index([customerId])
  @@index([dueDate])
  @@index([paymentMethod])
  @@index([status])
  @@index([isDeleted])
  @@index([deletedAt])
}

model saleitem {
  id               Int            @id @default(autoincrement())
  quantity         Int
  productId        Int
  saleId           Int
  price            Float          // Selling price at time of sale
  total            Float          // Total selling price (quantity * price)
  
  // ===== NEW COST TRACKING FIELDS =====
  costAtSale       Float?         // Production cost at the time of sale
  totalCost        Float?         // Total cost (quantity * costAtSale)
  profitMargin     Float?         // (total - totalCost) / total * 100
  costSnapshot     Json?          // Full cost snapshot for auditing
  
  staffInventoryId Int?
  
  product          product        @relation(fields: [productId], references: [id])
  sale             sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  staffInventory   staffInventory? @relation(fields: [staffInventoryId], references: [id])

  @@index([staffInventoryId])
  @@index([productId])
  @@index([saleId])
  @@index([costAtSale])  // Add index for cost lookups
}

model productCostHistory {
  id          Int      @id @default(autoincrement())
  productId   Int
  costPrice   Float    // The cost at this point in time
  effectiveDate DateTime @default(now()) // When this cost became effective
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  product     product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([productId])
  @@index([effectiveDate])
  @@unique([productId, effectiveDate]) // One cost per date per product
}

model creditor {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  phone       String?
  email       String?
  totalOwed   Float     @default(0)
  restocks    restock[]
  payments    payment[] @relation("CreditorPayments") // Named relation matching payment model
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model staff {
  id               Int               @id @default(autoincrement())
  name             String
  email            String?
  phone            String?
  staffInventories staffInventory[]
  createdSales     sale[]            @relation("CreatedSales")
  assignedSales    sale[]            @relation("AssignedSales")
  createdExpenses  expense[]         @relation("ExpenseCreatedBy")
  updatedExpenses  expense[]         @relation("ExpenseUpdatedBy")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model staffInventory {
  id               Int       @id @default(autoincrement())
  staffId          Int
  productId        Int

  weekStartDate    DateTime?
  weekEndDate      DateTime?

  quantityGiven    Int
  quantitySold     Int       @default(0)
  quantityReturned Int       @default(0)

  staff            staff     @relation(fields: [staffId], references: [id])
  product          product   @relation(fields: [productId], references: [id])
  saleItems        saleitem[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([staffId])
  @@index([productId])
}

model smsreminder {
  id          Int       @id @default(autoincrement())
  saleId      Int
  customerId  Int
  phone       String
  message     String
  type        String
  status      String    @default("SENT")
  sentAt      DateTime  @default(now())
  deliveredAt DateTime?
  customer    customer  @relation(fields: [customerId], references: [id])
  sale        sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([saleId])
  @@index([status])
  @@index([type])
}

model systemsetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime

  @@index([key])
}

model tradein {
  id              Int      @id @default(autoincrement())

  saleId          Int
  paymentId       Int?
  customerId      Int

  itemName        String
  description     String?
  category        String?

  quantity        Int      @default(1)

  estimatedValue  Float
  agreedValue     Float

  condition       String
  status          String   @default("PENDING")

  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sale            sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  payment         payment? @relation(fields: [paymentId], references: [id])
  customer        customer @relation(fields: [customerId], references: [id])

  @@index([saleId])
  @@index([customerId])
  @@index([status])
}

// ==================== NEW MODELS FOR AUDIT & SOFT DELETE ====================

model saleauditlog {
  id              Int      @id @default(autoincrement())
  saleId          Int
  action          String
  fieldName       String?
  oldValue        String?
  newValue        String?
  difference      String?
  changedBy       String
  changedByEmail  String?
  changedAt       DateTime @default(now())
  ipAddress       String?
  userAgent       String?
  snapshot        Json?
  notes           String?

  sale            sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([action])
  @@index([changedAt])
  @@index([changedBy])
}

model deletedsale {
  id                Int      @id @default(autoincrement())
  originalSaleId    Int      @unique
  saleData          Json
  customerName      String
  customerPhone     String?
  customerId        Int?
  totalAmount       Float
  saleDate          DateTime
  statusAtDeletion  String
  dueDate           DateTime?
  deletedAt         DateTime @default(now())
  deletedBy         String
  deletedByEmail    String?
  deletionReason    String?
  ipAddress         String?
  restoredAt        DateTime?
  restoredBy        String?
  restoredByEmail   String?
  saleItemsSummary  String
  paymentsSummary   String?
  restockedItems    Boolean  @default(false)
  expiresAt         DateTime

  customer          customer? @relation(fields: [customerId], references: [id])

  @@index([deletedAt])
  @@index([expiresAt])
  @@index([originalSaleId])
  @@index([customerName])
  @@index([deletedBy])
  @@index([statusAtDeletion])
  @@index([customerId])
  @@index([restoredAt])
}

enum payment_status {
  PENDING
  CLEARED
  BOUNCED
  COMPLETED
}