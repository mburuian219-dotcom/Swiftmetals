generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model catalogproduct {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  isPublic    Boolean  @default(true)
  inStock     Boolean  @default(true)
  image       String?
}

model customer {
  id                Int                 @id @default(autoincrement())
  name              String
  email             String?
  createdAt         DateTime            @default(now())
  phone             String?
  totalCredit       Float               @default(0)
  manualmessagetask manualmessagetask[]
  order             order[]
  sale              sale[]
  smsreminder       smsreminder[]
}

model expense {
  id        Int      @id @default(autoincrement())
  title     String
  amount    Float
  category  String?
  notes     String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cashledger cashledger[]

}

model invoice {
  id            Int      @id @default(autoincrement())
  invoiceNumber String   @unique(map: "Invoice_invoiceNumber_key")
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  saleId        Int
  totalAmount   Float
  amountPaid    Float    @default(0)
  balance       Float
  generatedBy   Int
  status        String   @default("UNPAID")
  sale          sale     @relation(fields: [saleId], references: [id], map: "Invoice_saleId_fkey")

  @@index([saleId], map: "Invoice_saleId_fkey")
}

model manualmessagetask {
  id            Int       @id @default(autoincrement())
  customerId    Int
  phone         String
  message       String
  failureReason String?
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
  customer      customer  @relation(fields: [customerId], references: [id], onDelete: Cascade, map: "ManualMessageTask_customerId_fkey")

  @@index([customerId], map: "ManualMessageTask_customerId_idx")
  @@index([status], map: "ManualMessageTask_status_idx")
}

model order {
  id         Int      @id @default(autoincrement())
  quantity   Int
  amount     Float
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  customerId Int
  productId  Int
  customer   customer @relation(fields: [customerId], references: [id], map: "Order_customerId_fkey")
  product    product  @relation(fields: [productId], references: [id], map: "Order_productId_fkey")

  @@index([customerId], map: "Order_customerId_fkey")
  @@index([productId], map: "Order_productId_fkey")
}

model payment {
  id               Int            @id @default(autoincrement())
  saleId           Int
  amount           Float
  method           String
  note             String?
  paidAt           DateTime       @default(now())
  bankName         String?
  checkDate        DateTime?
  checkNumber      String?
  isVerified       Boolean        @default(false)
  referenceId      String?
  verifiedAt       DateTime?
  checkDepositDate DateTime?
  status           payment_status @default(PENDING)
  sale             sale           @relation(fields: [saleId], references: [id], onDelete: Cascade, map: "Payment_saleId_fkey")

  @@index([isVerified], map: "Payment_isVerified_idx")
  @@index([method], map: "Payment_method_idx")
  @@index([saleId], map: "Payment_saleId_idx")
  @@index([status], map: "Payment_status_idx")
}

model paymentschedule {
  id                Int       @id @default(autoincrement())
  saleId            Int
  installmentNumber Int
  dueAmount         Float
  dueDate           DateTime
  isPaid            Boolean   @default(false)
  paidAmount        Float     @default(0)
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  sale              sale      @relation(fields: [saleId], references: [id], onDelete: Cascade, map: "PaymentSchedule_saleId_fkey")

  @@index([dueDate], map: "PaymentSchedule_dueDate_idx")
  @@index([isPaid], map: "PaymentSchedule_isPaid_idx")
  @@index([saleId], map: "PaymentSchedule_saleId_idx")
}

/// --- new model: openingbalance ---
model openingbalance {
  id         Int      @id @default(autoincrement())
  amount     Float
  date       DateTime @default(now())  // the effective date of this opening balance
  description String?                  // optional note (e.g., "Opening balance for FY 2025")
  recordedBy String?                   // optional (user id or username who recorded it)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model product {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  price       Float
  category    String?
  productionCost Float?   // 👈 add this
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  isPublic    Boolean    @default(false)
  image       String?
  inStock     Boolean    @default(true)
  order       order[]
  saleitem    saleitem[]
  stock       stock[]
  restock       restock[]   // 👈 added relation to restock
}


model stock {
  id           Int      @id @default(autoincrement())
  name         String
  quantity     Int      @default(0)
  costPrice    Float
  sellingPrice Float
  supplier     String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  productId    Int
  product      product  @relation(fields: [productId], references: [id], map: "Stock_productId_fkey")

  @@index([productId], map: "Stock_productId_idx")
}
model restock {
  id              Int          @id @default(autoincrement())
  productId       Int
  quantity        Int
  costPrice       Float
  totalCost       Float
  paymentSource   String       // "cash", "credit", etc.
  creditorId      Int?
  creditor        creditor?    @relation(fields: [creditorId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  product         product      @relation(fields: [productId], references: [id], map: "Restock_productId_fkey")

  cashledger      cashledger[] @relation("RestockToLedger") // ✅ add relation name

  @@index([productId])
  @@index([creditorId])
}
model cashledger {
  id                   Int                    @id @default(autoincrement())
  date                 DateTime               @default(now())
  description          String
  type                 String
  category             String
  amount               Float
  runningBalance       Float?                 // make nullable for now
  relatedTo            String?
  affectedAccounts     String?
  referenceId          Int?
  referenceType        String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  email                String?                // make nullable
  token                String?                // make nullable

  saleId     Int?
  sale       sale?       @relation(fields: [saleId], references: [id])

  expenseId  Int?
  expense    expense?    @relation(fields: [expenseId], references: [id])

  restockId  Int?
  restock    restock?    @relation("RestockToLedger", fields: [restockId], references: [id])

  dailyOpeningBalanceId Int?
  dailyOpeningBalance   dailyopeningbalance?  @relation(fields: [dailyOpeningBalanceId], references: [id])

  @@index([date])
  @@index([type])
  @@index([category])
  @@index([referenceType])
}

model dailyopeningbalance {
  id          Int           @id @default(autoincrement())
  date        DateTime      @default(now())
  amount      Float
  description String?
  recordedBy  String?
  cashledgers cashledger[]  // 👈 add opposite relation
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}



model sale {
  id               Int               @id @default(autoincrement())
  customerId       Int
  amount           Float
  date             DateTime          @default(now())
  createdAt        DateTime          @default(now())
  dueDate          DateTime?
  status           String            @default("UNPAID")
  updatedAt        DateTime          @updatedAt

  checkDepositDate DateTime?
  isCheckDeposited Boolean           @default(false)

  lastReminderDate DateTime?
  paymentMethod    String            @default("CASH")
  remindersSent    Int               @default(0)

  invoice          invoice[]
  payment          payment[]
  paymentschedule  paymentschedule[]
  saleitem         saleitem[]
  smsreminder      smsreminder[]
  cashledger       cashledger[]

  customer         customer @relation(fields: [customerId], references: [id], map: "Sale_customerId_fkey")

  // Audit fields (kept)
  updatedBy        String?
  createdBy        String?

  @@index([checkDepositDate], map: "Sale_checkDepositDate_idx")
  @@index([customerId], map: "Sale_customerId_fkey")
  @@index([dueDate], map: "Sale_dueDate_idx")
  @@index([paymentMethod], map: "Sale_paymentMethod_idx")
  @@index([status], map: "Sale_status_idx")
}

model saleitem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  productId Int
  saleId    Int
  price     Float
  total     Float
  product   product @relation(fields: [productId], references: [id], map: "SaleItem_productId_fkey")
  sale      sale    @relation(fields: [saleId], references: [id], onDelete: Cascade, map: "SaleItem_saleId_fkey")

  @@index([productId], map: "SaleItem_productId_fkey")
  @@index([saleId], map: "SaleItem_saleId_idx")
}
model creditor {
  id          Int        @id @default(autoincrement())
  name        String   @unique
  phone       String?
  email       String?
  totalOwed   Float       @default(0)
  restocks    restock[]   // 👈 linked to purchases/restocks
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}


model smsreminder {
  id          Int       @id @default(autoincrement())
  saleId      Int
  customerId  Int
  phone       String
  message     String
  type        String
  status      String    @default("SENT")
  sentAt      DateTime  @default(now())
  deliveredAt DateTime?
  customer    customer  @relation(fields: [customerId], references: [id], map: "SmsReminder_customerId_fkey")
  sale        sale      @relation(fields: [saleId], references: [id], onDelete: Cascade, map: "SmsReminder_saleId_fkey")

  @@index([customerId], map: "SmsReminder_customerId_idx")
  @@index([saleId], map: "SmsReminder_saleId_idx")
  @@index([status], map: "SmsReminder_status_idx")
  @@index([type], map: "SmsReminder_type_idx")
}

model systemsetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique(map: "SystemSetting_key_key")
  value       String
  description String?
  updatedAt   DateTime

  @@index([key], map: "SystemSetting_key_idx")
}

enum payment_status {
  PENDING
  CLEARED
  BOUNCED
  COMPLETED
}
